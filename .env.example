# ─── Provider credentials (never commit real values) ────────────────────────
MAPBOX_TOKEN=pk.your_token_here
MAPBOX_BASE_URL=https://api.mapbox.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=weelp-gateway/0.1 (you@example.com)

# ─── Networking ─────────────────────────────────────────────────────────────
GATEWAY_PORT=9100
# Externally visible base URL — used for log enrichment and any future webhook signing.
# Dev: http://localhost:9100. Prod: https://gateway.weelp.com.
GATEWAY_PUBLIC_URL=http://localhost:9100
# CORS allow-list. Frontend (weelp.com prod, localhost:3000 dev) must both work.
CORS_ORIGINS=http://localhost:3000,https://weelp.com

# ─── Cache & resilience ─────────────────────────────────────────────────────
# Inside docker compose: redis://redis:6379/0. On the host: redis://localhost:6379/0.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TTL_SECONDS=30

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_MIN_AUTH=600
# Optional: defaults to REDIS_URL. Set to "memory://" to keep limits in-process (tests, dev).
RATE_LIMIT_STORAGE_URI=

# ─── Logging & runtime ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Uvicorn worker count inside the container. 2 is fine for a small VM; bump for bigger hosts.
WEB_CONCURRENCY=2

# ─── Observability (Phase 7) ────────────────────────────────────────────────
# Tracing is opt-in. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable — the
# gateway logs `tracing.disabled` once at startup and never tries to export.
# Local Jaeger: docker run -p 4317:4317 -p 16686:16686 jaegertracing/all-in-one
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=weelp-gateway
# parentbased_traceidratio honours an inbound `traceparent`; otherwise samples at
# the ratio below. 0.1 = 10% in prod; raise to 1.0 in dev to see every span.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ─── Auth bridge ────────────────────────────────────────────────────────────
# Must match weelp/backend/.env JWT_SECRET exactly. Rotation is a coordinated two-stage deploy.
# Staging and prod values diverge — never reuse the same secret across environments.
JWT_SECRET=
JWT_ALGORITHM=HS256
