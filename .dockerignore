# keep build context lean — small context, fast rebuilds, smaller image
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info

# never ship secrets into the image
.env
.env.*
!.env.example

# editor / OS noise
.idea
.vscode
.DS_Store
*.swp

# docs / docker artifacts (not needed at runtime)
docs
deploy
docker-compose*.yml
compose*.yml
Dockerfile
.dockerignore
